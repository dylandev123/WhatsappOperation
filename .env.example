# Server
PORT=3030
ADMIN_SECRET=change-this-long-random-secret

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL for saved media links. Optional at first.
# Example after nginx: https://whatsapp.coolandpool.com
PUBLIC_BASE_URL=http://localhost:3030

# Comma-separated business session IDs
BUSINESSES=dog_food,by_sea,cool_pool,candock

# Scheduled messages executor (off unless true). Schema lives in the inbox repo.
SCHEDULER_ENABLED=false
SCHEDULER_POLL_MS=20000
# Pause between recipients of one run (ms)
SCHEDULER_DELAY_MS=8000
# 'sending' deliveries older than this become 'unknown' (never retried)
SCHEDULER_STALE_SENDING_MS=120000
# Optional; defaults to bridge-<pid>
SCHEDULER_WORKER_ID=

# Inbox AI agent bridge (src/agent). Contract and schema are owned by the
# inbox repo (docs/ai-agent-bridge-contract.md, ai_agent_* tables).
# AGENT_ENABLED forwards live messages to the inbox. Nothing is sent unless
# AGENT_SEND_ENABLED=true (global kill switch, covers staff notices too) AND the
# inbox has the business in Assisted mode, or in Observe mode with staff notices
# enabled (then staff_notice to the staff group only; never customers).
AGENT_ENABLED=false
AGENT_SEND_ENABLED=false
# Inbox base URL, e.g. https://inbox.example.com (no path)
AI_AGENT_URL=
# Same value as AI_AGENT_BRIDGE_SECRET on the inbox deployment
AI_AGENT_BRIDGE_SECRET=
# Local transport journal (keep on the ./auth volume so it survives rebuilds)
AGENT_STATE_FILE=./auth/agent-bridge-state.json
# Customer inactivity window before a burst is forwarded (ms)
AGENT_BATCH_WINDOW_MS=10000
AGENT_TICK_MS=2000
AGENT_CONFIG_TTL_MS=60000
# Customer messages older than this are never forwarded or answered (ms)
AGENT_MAX_MESSAGE_AGE_MS=600000
AGENT_MAX_CHAT_REPLIES_PER_HOUR=4
AGENT_MAX_BUSINESS_SENDS_PER_MINUTE=3
AGENT_MIN_SEND_GAP_MS=5000
AGENT_MAX_FORWARD_ATTEMPTS=3
# After a send with unknown outcome, no AI messages to that chat for this long (ms)
AGENT_UNKNOWN_SEND_HOLD_MS=21600000
