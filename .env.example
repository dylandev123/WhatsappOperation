# Server
PORT=3030
ADMIN_SECRET=change-this-long-random-secret

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL for saved media links. Optional at first.
# Example after nginx: https://whatsapp.coolandpool.com
PUBLIC_BASE_URL=http://localhost:3030

# Comma-separated business session IDs
BUSINESSES=dog_food,by_sea,cool_pool,candock

# Scheduled messages executor (off unless true). Schema lives in the inbox repo.
SCHEDULER_ENABLED=false
SCHEDULER_POLL_MS=20000
# Pause between recipients of one run (ms)
SCHEDULER_DELAY_MS=8000
# 'sending' deliveries older than this become 'unknown' (never retried)
SCHEDULER_STALE_SENDING_MS=120000
# Optional; defaults to bridge-<pid>
SCHEDULER_WORKER_ID=
